# Lakebase connection details. None of these are secrets - the password is an
# OAuth token the app mints at runtime, so nothing here expires.
PGHOST=<your-instance>.database.<region>.cloud.databricks.com
PGPORT=5432
PGDATABASE=databricks_postgres
PGUSER=you@example.com
PGSSLMODE=require

LAKEBASE_INSTANCE_NAME=

